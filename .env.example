ANTHROPIC_API_KEY=your_anthropic_api_key_here
NEO4J_URI=neo4j+s://your-neo4j-uri
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id

# --- Salesforce (Phase 4 adapter; leave unset to use fixtures) -------------
# FIRMOS_CRM_SOURCE=fixtures        # or: salesforce
# SF_INSTANCE_URL=https://your-org.my.salesforce.com
# SF_ACCESS_TOKEN=your_salesforce_access_token
# SF_API_VERSION=v60.0
# SF_ENGAGEMENT_OBJECT=firmOS_Engagement__c
# SF_DOCUMENT_OBJECT=firmOS_Document__c
# SF_MAPPING_CONFIRMED=            # set to 1 ONLY after an admin confirms the
#                                  # custom object/field API names in the org
# --- live sandbox integration tier (skipped unless all are set) -----------
# FIRMOS_SF_INTEGRATION=1
# FIRMOS_SF_TEST_ACCOUNT_ID=001xxxxxxxxxxxxxxx

# --- HITL approval store ---------------------------------------------------
# Unset  = in-memory (approvals are LOST on restart; demos and tests only).
# Set    = durable SQLite. Approvals are audit records retained per
#          governance/GOVERNANCE.md §5.1, so any real use must set this.
# FIRMOS_APPROVAL_DB=approvals/approvals.db
